#!/bin/bash
# Root-privileged control for AmneziaWG connections used by the OmneziaVpn
# bar plugin. Every server id is validated against awg-quick's own interface
# name pattern before it ever touches a path or command, so there is no
# user-controlled input that reaches the shell unsanitized.
set -euo pipefail

DIR=/etc/amnezia/amneziawg
NAME_RE='^[a-zA-Z0-9_=+.-]{1,15}$'

require_name() {
  [[ "$1" =~ $NAME_RE ]] || { echo "invalid server id" >&2; exit 1; }
}

# One "awg show interfaces" call plus plain string matching against the
# configured names -- no per-config subprocess, unlike calling "awg show
# <name>" once per saved server.
active_iface() {
  local ifaces=" $(awg show interfaces 2>/dev/null) " f n
  for f in "$DIR"/*.conf; do
    [ -e "$f" ] || continue
    n=$(basename "$f" .conf)
    case "$ifaces" in *" $n "*) echo "$n"; return 0 ;; esac
  done
  return 0
}

case "${1:-}" in
  status)
    cur=$(active_iface || true)
    if [ -z "$cur" ]; then
      echo '{"iface":""}'
      exit 0
    fi
    # "dump" gives transfer counters and the handshake time for every peer
    # in one call; the first line is interface info (skipped), not a peer.
    rx=0
    tx=0
    hs=0
    first=1
    while IFS=$'\t' read -r _f1 _f2 _f3 _f4 f5 f6 f7 _f8; do
      if [ "$first" = 1 ]; then first=0; continue; fi
      rx=$((rx + ${f6:-0}))
      tx=$((tx + ${f7:-0}))
      if [ -n "${f5:-}" ] && [ "$f5" -gt "$hs" ] 2>/dev/null; then hs=$f5; fi
    done < <(awg show "$cur" dump 2>/dev/null)
    printf '{"iface":"%s","rx":%s,"tx":%s,"handshake":%s}\n' "$cur" "$rx" "$tx" "$hs"
    ;;
  last)
    if [ -f "$DIR/.last" ]; then
      cat "$DIR/.last"
    fi
    ;;
  up)
    name="${2:-}"
    require_name "$name"
    [ -f "$DIR/$name.conf" ] || { echo "unknown server: $name" >&2; exit 1; }
    cur=$(active_iface || true)
    if [ -n "$cur" ] && [ "$cur" != "$name" ]; then
      awg-quick down "$cur"
    fi
    if [ "$cur" != "$name" ]; then
      awg-quick up "$name"
    fi
    printf '%s' "$name" > "$DIR/.last"
    ;;
  down)
    cur=$(active_iface || true)
    if [ -n "$cur" ]; then
      awg-quick down "$cur"
    fi
    ;;
  save)
    name="${2:-}"
    require_name "$name"
    mkdir -p "$DIR"
    tmp=$(mktemp "$DIR/.${name}.XXXXXX")
    cat > "$tmp"
    if ! grep -q '^\[Interface\]' "$tmp" || ! grep -q '^\[Peer\]' "$tmp"; then
      rm -f "$tmp"
      echo "invalid config: missing [Interface]/[Peer]" >&2
      exit 1
    fi
    chmod 600 "$tmp"
    mv "$tmp" "$DIR/$name.conf"
    ;;
  remove)
    name="${2:-}"
    require_name "$name"
    cur=$(active_iface || true)
    if [ "$cur" = "$name" ]; then
      awg-quick down "$name"
    fi
    rm -f "$DIR/$name.conf"
    if [ -f "$DIR/.last" ] && [ "$(cat "$DIR/.last")" = "$name" ]; then
      rm -f "$DIR/.last"
    fi
    ;;
  *)
    echo "usage: omarchy-vpn-ctl {up <id>|down|status|last|save <id>|remove <id>}" >&2
    exit 1
    ;;
esac
