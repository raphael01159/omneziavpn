#!/bin/bash
# Root-privileged control for AmneziaWG connections used by the OmneziaVpn
# bar plugin. Every server id is validated against awg-quick's own interface
# name pattern before it ever touches a path or command, so there is no
# user-controlled input that reaches the shell unsanitized.
set -euo pipefail

DIR=/etc/amnezia/amneziawg
NAME_RE='^[a-zA-Z0-9_=+.-]{1,15}$'

require_name() {
  [[ "$1" =~ $NAME_RE ]] || { echo "invalid server id" >&2; exit 1; }
}

active_iface() {
  local f n
  for f in "$DIR"/*.conf; do
    [ -e "$f" ] || continue
    n=$(basename "$f" .conf)
    if awg show "$n" >/dev/null 2>&1; then
      echo "$n"
      return 0
    fi
  done
  return 0
}

case "${1:-}" in
  status)
    active_iface || true
    ;;
  stats)
    cur=$(active_iface || true)
    if [ -z "$cur" ]; then
      echo '{}'
      exit 0
    fi
    rx=0
    tx=0
    while read -r _peer r t _rest; do
      rx=$((rx + ${r:-0}))
      tx=$((tx + ${t:-0}))
    done < <(awg show "$cur" transfer 2>/dev/null)
    hs=0
    while read -r _peer h; do
      [ "${h:-0}" -gt "$hs" ] && hs=$h
    done < <(awg show "$cur" latest-handshakes 2>/dev/null)
    printf '{"rx":%s,"tx":%s,"handshake":%s}\n' "$rx" "$tx" "$hs"
    ;;
  last)
    if [ -f "$DIR/.last" ]; then
      cat "$DIR/.last"
    fi
    ;;
  up)
    name="${2:-}"
    require_name "$name"
    [ -f "$DIR/$name.conf" ] || { echo "unknown server: $name" >&2; exit 1; }
    cur=$(active_iface || true)
    if [ -n "$cur" ] && [ "$cur" != "$name" ]; then
      awg-quick down "$cur"
    fi
    if [ "$cur" != "$name" ]; then
      awg-quick up "$name"
    fi
    printf '%s' "$name" > "$DIR/.last"
    ;;
  down)
    cur=$(active_iface || true)
    if [ -n "$cur" ]; then
      awg-quick down "$cur"
    fi
    ;;
  save)
    name="${2:-}"
    require_name "$name"
    mkdir -p "$DIR"
    tmp=$(mktemp "$DIR/.${name}.XXXXXX")
    cat > "$tmp"
    if ! grep -q '^\[Interface\]' "$tmp" || ! grep -q '^\[Peer\]' "$tmp"; then
      rm -f "$tmp"
      echo "invalid config: missing [Interface]/[Peer]" >&2
      exit 1
    fi
    chmod 600 "$tmp"
    mv "$tmp" "$DIR/$name.conf"
    ;;
  remove)
    name="${2:-}"
    require_name "$name"
    cur=$(active_iface || true)
    if [ "$cur" = "$name" ]; then
      awg-quick down "$name"
    fi
    rm -f "$DIR/$name.conf"
    if [ -f "$DIR/.last" ] && [ "$(cat "$DIR/.last")" = "$name" ]; then
      rm -f "$DIR/.last"
    fi
    ;;
  *)
    echo "usage: omarchy-vpn-ctl {up <id>|down|status|stats|last|save <id>|remove <id>}" >&2
    exit 1
    ;;
esac
